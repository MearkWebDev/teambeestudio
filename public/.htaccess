# SPA deep-link fallback for Apache (Hostinger / cPanel).
# Any request that is not a real file or directory is served index.html
# so React Router can render the requested route (/films, /about, ...).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite existing files or directories (assets, images, favicon...)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> index.html (200, not a redirect: the URL is preserved)
  RewriteRule ^ index.html [L]
</IfModule>

# Cache hashed build assets aggressively, never cache the HTML shell
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
